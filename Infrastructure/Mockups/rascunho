   public void Add<T>(T entity)
   {
      if (entity is Aluno aluno)
      {
         aluno.Id = _alunos.Select(a => a.Id).Max() + 1;
         _alunos.Add(aluno);
      }
      else if (entity is Atividade atividade)
      {
         atividade.Id = _atividades.Select(a => a.Id).Max() + 1;
         _atividades.Add(atividade);
      }
      else if (entity is AlunoAtividade alunoAtividade)
      {
         _alunosAtividades.Add(alunoAtividade);
      }
      else
      {
         throw new ArgumentException("Tipo de entidade não suportado.");
      }
   }

